@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Middle</title>

    <style>
        :root {
            --middle-teal: #09a7ad;
            --middle-teal-dark: #078f96;
            --middle-teal-light: #6fd3d4;
            --ink: #25313a;
            --muted: #6f7d84;
            --line: #e7edef;
            --panel: rgba(255, 255, 255, 0.97);
        }

        * {
            box-sizing: border-box;
        }

        html,
        body {
            margin: 0;
            min-height: 100%;
            font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
            color: var(--ink);
            background: #f6fafb;
        }

        body {
            min-height: 100vh;
        }

        .login-page {
            position: relative;
            min-height: 100vh;
            overflow: hidden;
            background:
                radial-gradient(circle at 78% 18%, rgba(255,255,255,.22), transparent 28%),
                radial-gradient(circle at 20% 70%, rgba(255,255,255,.14), transparent 32%),
                linear-gradient(135deg, #67c7c9 0%, var(--middle-teal) 47%, #198e9b 100%);
        }

        .login-page::before,
        .login-page::after {
            content: "";
            position: absolute;
            border-radius: 999px;
            pointer-events: none;
            filter: blur(2px);
        }

        .login-page::before {
            width: 520px;
            height: 520px;
            right: -190px;
            top: -220px;
            background: rgba(255,255,255,.08);
        }

        .login-page::after {
            width: 360px;
            height: 360px;
            left: -170px;
            bottom: 2%;
            background: rgba(255,255,255,.08);
        }

        .shell {
            position: relative;
            z-index: 1;
            min-height: 100vh;
            display: grid;
            grid-template-columns: minmax(0, 1.15fr) minmax(420px, .85fr);
            gap: 56px;
            align-items: center;
            max-width: 1260px;
            margin: 0 auto;
            padding: 48px 58px;
        }

        .brand-panel {
            align-self: stretch;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 600px;
            padding: 4px 0;
        }

        .brand-logo {
            display: block;
            width: min(260px, 52vw);
            height: auto;
            filter: brightness(0) invert(1);
        }

        .hero-copy {
            max-width: 640px;
            margin: auto 0;
            padding: 54px 0 94px;
            color: white;
        }

        .eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 18px;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: .14em;
            text-transform: uppercase;
            opacity: .82;
        }

        .eyebrow::before {
            content: "";
            width: 38px;
            height: 2px;
            background: currentColor;
            border-radius: 999px;
        }

        .hero-copy h1 {
            margin: 0;
            max-width: 520px;
            font-size: clamp(48px, 6vw, 82px);
            line-height: .96;
            letter-spacing: -.045em;
            font-weight: 800;
        }

        .hero-copy p {
            margin: 24px 0 0;
            max-width: 560px;
            font-size: 17px;
            line-height: 1.65;
            color: rgba(255,255,255,.82);
        }

        .micro-copy {
            color: rgba(255,255,255,.72);
            font-size: 13px;
            letter-spacing: .02em;
        }

        .login-wrap {
            display: flex;
            justify-content: flex-end;
        }

        .login-card {
            width: min(100%, 470px);
            background: var(--panel);
            border: 1px solid rgba(255,255,255,.72);
            border-radius: 34px;
            padding: 42px;
            box-shadow: 0 32px 80px rgba(4, 77, 83, .24);
            backdrop-filter: blur(18px);
            -webkit-backdrop-filter: blur(18px);
        }

        .card-kicker {
            margin: 0 0 8px;
            font-size: 12px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .14em;
            color: var(--middle-teal-dark);
        }

        .login-card h2 {
            margin: 0;
            font-size: 32px;
            letter-spacing: -.03em;
        }

        .card-subtitle {
            margin: 10px 0 30px;
            color: var(--muted);
            line-height: 1.55;
            font-size: 14px;
        }

        .field {
            margin-bottom: 16px;
        }

        .field label {
            display: block;
            margin: 0 0 8px;
            font-size: 13px;
            font-weight: 700;
            color: #45545c;
        }

        .input-shell {
            display: flex;
            align-items: center;
            min-height: 58px;
            background: white;
            border: 1px solid var(--line);
            border-radius: 17px;
            box-shadow: 0 7px 18px rgba(27, 77, 83, .06);
            transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;
        }

        .input-shell:focus-within {
            border-color: rgba(9, 167, 173, .65);
            box-shadow: 0 0 0 4px rgba(9, 167, 173, .10), 0 10px 22px rgba(27, 77, 83, .08);
            transform: translateY(-1px);
        }

        .field-icon {
            width: 50px;
            flex: 0 0 50px;
            display: grid;
            place-items: center;
            color: var(--middle-teal-dark);
        }

        .field-icon svg {
            width: 20px;
            height: 20px;
        }

        .input-shell input {
            width: 100%;
            min-width: 0;
            border: 0;
            outline: 0;
            background: transparent;
            color: var(--ink);
            font: inherit;
            padding: 0 14px 0 0;
        }

        .input-shell input::placeholder {
            color: #9ba6ab;
        }

        .password-toggle {
            appearance: none;
            border: 0;
            background: transparent;
            width: 48px;
            height: 48px;
            display: grid;
            place-items: center;
            color: var(--middle-teal-dark);
            cursor: pointer;
            border-radius: 14px;
        }

        .password-toggle:hover,
        .password-toggle:focus-visible {
            background: rgba(9,167,173,.08);
            outline: none;
        }

        .password-toggle svg {
            width: 20px;
            height: 20px;
        }

        .form-options {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            margin: 18px 2px 28px;
            font-size: 13px;
        }

        .remember {
            display: inline-flex;
            align-items: center;
            gap: 9px;
            color: #5f6d74;
            cursor: pointer;
        }

        .remember input {
            width: 17px;
            height: 17px;
            accent-color: var(--middle-teal);
        }

        .forgot-link {
            color: var(--middle-teal-dark);
            font-weight: 700;
            text-decoration: none;
        }

        .forgot-link:hover {
            text-decoration: underline;
        }

        .login-button {
            width: 100%;
            min-height: 56px;
            border: 0;
            border-radius: 17px;
            background: linear-gradient(135deg, var(--middle-teal), var(--middle-teal-dark));
            color: white;
            font: inherit;
            font-weight: 800;
            letter-spacing: .025em;
            cursor: pointer;
            box-shadow: 0 14px 28px rgba(9, 153, 160, .25);
            transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
        }

        .login-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 18px 34px rgba(9, 153, 160, .30);
            filter: saturate(1.05);
        }

        .login-button:active {
            transform: translateY(0);
        }

        .company-line {
            margin: 24px 0 0;
            text-align: center;
            color: #748087;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .12em;
            text-transform: uppercase;
        }

        .validation-summary-errors,
        .field-validation-error {
            color: #b42318;
            font-size: 12px;
        }

        @media (max-width: 900px) {
            .login-page {
                background:
                    radial-gradient(circle at 72% 14%, rgba(255,255,255,.18), transparent 30%),
                    linear-gradient(155deg, #67c7c9 0%, var(--middle-teal) 58%, #168d97 100%);
            }

            .shell {
                display: block;
                padding: 30px 24px 0;
            }

            .brand-panel {
                min-height: auto;
            }

            .brand-logo {
                width: 180px;
            }

            .hero-copy {
                padding: 70px 0 132px;
            }

            .hero-copy h1 {
                font-size: clamp(46px, 12vw, 68px);
                max-width: 420px;
            }

            .hero-copy p {
                max-width: 480px;
                font-size: 15px;
            }

            .micro-copy {
                display: none;
            }

            .login-wrap {
                margin: 0 -24px;
            }

            .login-card {
                width: 100%;
                max-width: none;
                border-radius: 38px 38px 0 0;
                border: 0;
                padding: 38px 24px 42px;
                box-shadow: 0 -18px 44px rgba(4, 77, 83, .10);
            }
        }

        @media (max-width: 520px) {
            .shell {
                padding-top: 24px;
            }

            .brand-logo {
                width: 150px;
            }

            .hero-copy {
                padding: 58px 0 112px;
            }

            .eyebrow {
                font-size: 11px;
            }

            .hero-copy h1 {
                font-size: 48px;
            }

            .hero-copy p {
                font-size: 14px;
                margin-top: 18px;
            }

            .login-card h2 {
                font-size: 28px;
            }

            .form-options {
                align-items: flex-start;
                flex-direction: column;
                gap: 12px;
            }
        }
    </style>
</head>
<body>
    <main class="login-page">
        <div class="shell">
            <section class="brand-panel" aria-label="Middle brand introduction">
                <a href="/" aria-label="Middle home">
                    <img
                        class="brand-logo"
                        src="~/images/middle-logo.png"
                        alt="Middle" />
                </a>

                <div class="hero-copy">
                    <div class="eyebrow">Secure client portal</div>
                    <h1>Welcome back.</h1>
                    <p>
                        Sign in to continue to your Middle workspace and access the tools,
                        information and services you use every day.
                    </p>
                </div>

                <div class="micro-copy">JARC Group of Companies</div>
            </section>

            <section class="login-wrap" aria-label="Login form">
                <div class="login-card">
                    <p class="card-kicker">Member access</p>
                    <h2>Log in</h2>
                    <p class="card-subtitle">Enter your account details to continue.</p>

                    <form method="post" asp-controller="Account" asp-action="Login" novalidate>
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"></div>

                        <div class="field">
                            <label for="Email">Username / Email</label>
                            <div class="input-shell">
                                <span class="field-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M20 21a8 8 0 0 0-16 0" />
                                        <circle cx="12" cy="7" r="4" />
                                    </svg>
                                </span>
                                <input id="Email" name="Email" type="text" autocomplete="username" placeholder="name@example.com" />
                            </div>
                        </div>

                        <div class="field">
                            <label for="Password">Password</label>
                            <div class="input-shell">
                                <span class="field-icon" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                        <rect x="5" y="10" width="14" height="10" rx="2" />
                                        <path d="M8 10V7a4 4 0 0 1 8 0v3" />
                                    </svg>
                                </span>
                                <input id="Password" name="Password" type="password" autocomplete="current-password" placeholder="Enter your password" />
                                <button class="password-toggle" type="button" aria-label="Show password" aria-pressed="false" onclick="togglePassword(this)">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z" />
                                        <circle cx="12" cy="12" r="2.5" />
                                    </svg>
                                </button>
                            </div>
                        </div>

                        <div class="form-options">
                            <label class="remember" for="RememberMe">
                                <input id="RememberMe" name="RememberMe" type="checkbox" value="true" />
                                <span>Remember me</span>
                            </label>

                            <a class="forgot-link" href="/Account/ForgotPassword">Forgot password?</a>
                        </div>

                        <button class="login-button" type="submit">Log in</button>
                    </form>

                    <p class="company-line">JARC Group of Companies</p>
                </div>
            </section>
        </div>
    </main>

    <script>
        function togglePassword(button) {
            const input = document.getElementById('Password');
            const showing = input.type === 'text';

            input.type = showing ? 'password' : 'text';
            button.setAttribute('aria-pressed', String(!showing));
            button.setAttribute('aria-label', showing ? 'Show password' : 'Hide password');
        }
    </script>
</body>
</html>
